    void getNameReturnsValidStringWhenNameIsSet() {
        // Arrange
        String expectedName = "Test Product";
        product.setName(expectedName);
        // Act
        String actualName = product.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }

  
    void getNameReturnsNullWhenNameIsNull() {
        // Arrange
        product.setName(null);
        // Act
        String actualName = product.getName();
        // Assert
        assertNull(actualName);
    }

  
    void getNameReturnsNullWhenNameIsNeverSet() {
        // Arrange
        // Product instance created in setUp() without setting any values
        // Act
        String actualName = product.getName();
        // Assert
        assertNull(actualName);
    }

  
    void getNameReturnsEmptyStringWhenNameIsEmpty() {
        // Arrange
        String expectedName = "";
        product.setName(expectedName);
        // Act
        String actualName = product.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }

  
    void getNameReturnsStringWithSpecialCharacters() {
        // Arrange
        String expectedName = "Product@#$%^&*()!";
        product.setName(expectedName);
        // Act
        String actualName = product.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }

  
    void getNameReturnsWhitespaceStringWhenNameIsWhitespace() {
        // Arrange
        String expectedName = "   ";
        product.setName(expectedName);
        // Act
        String actualName = product.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }

  
    void getNameReturnsLatestValueAfterMultipleUpdates() {
        // Arrange
        product.setName("First Name");
        product.setName("Second Name");
        String expectedName = "Final Name";
        product.setName(expectedName);
        // Act
        String actualName = product.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }

  
    void setUp_3() {
        product = new Product();
    }

  
    void getDescriptionReturnsValidStringWhenSet() {
        // Arrange
        String expectedDescription = "This is a valid product description";
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
    }

  
    void getDescriptionReturnsNullWhenNotSet() {
        // Arrange - Product instance created in setUp without setting description
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertNull(actualDescription);
    }

  
    void getDescriptionReturnsEmptyStringWhenSetToEmpty() {
        // Arrange
        String expectedDescription = "";
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
        assertTrue(actualDescription.isEmpty());
    }

  
    void getDescriptionReturnsStringWithSpecialCharacters() {
        // Arrange
        String expectedDescription = "Product with special chars: @#$%^&*()!<>?/\\";
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
    }

  
    void getDescriptionReturnsStringWithUnicodeCharacters() {
        // Arrange
        String expectedDescription = "产品描述 - Descripción del producto - תיאור המוצר";
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
    }

  
    void getDescriptionReturnsVeryLongString() {
        // Arrange
        StringBuilder longDescriptionBuilder = new StringBuilder();
        for (int i = 0; i < 10000; i++) {
            longDescriptionBuilder.append("a");
        }
        String expectedDescription = longDescriptionBuilder.toString();
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
        assertEquals(10000, actualDescription.length());
    }

  
    void getDescriptionReturnsWhitespaceOnlyString() {
        // Arrange
        String expectedDescription = "   \t  ";
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
    }

  
    void getDescriptionReturnsLatestValueAfterMultipleUpdates() {
        // Arrange
        product.setDescription("First description");
        product.setDescription("Second description");
        String expectedDescription = "Final description";
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
    }

  
