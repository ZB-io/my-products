  // Merged test methodspublic void testGetIdWhenIdIsSetReturnsCorrectValue() {
        Product product = new Product();
        product.setId(123L);
        assertEquals(123L, product.getId(), "ID should match set value");
    }

  public void testGetIdWhenIdNotSetReturnsNull() {
        Product product = new Product();
        assertNull(product.getId(), "Uninitialized ID should be null");
    }

  public void testGetIdAfterSettingNullReturnsNull() {
        Product product = new Product();
        product.setId(null);
        assertNull(product.getId(), "Explicitly null ID should return null");
    }

  public void testGetIdWithLongMaxValueReturnsCorrectly() {
        Product product = new Product();
        product.setId(Long.MAX_VALUE);
        assertEquals(Long.MAX_VALUE, product.getId(), "Should handle Long.MAX_VALUE");
    }

  public void testGetIdRemainsConsistentAfterOtherFieldChanges() {
        Product product = new Product();
        product.setId(456L);
        product.setName("Test Product");
        product.setPrice(99.99);
        
        assertEquals(456L, product.getId(), 
            "ID should remain unchanged after modifying other fields");
    }

  
    void getNameWhenNameIsSetThenReturnCorrectValue() {
        Product product = new Product();
        product.setName("Laptop");
        assertEquals("Laptop", product.getName());
    }

  
    void getNameWhenNameIsEmptyStringThenReturnEmpty() {
        Product product = new Product();
        product.setName("");
        assertTrue(product.getName().isEmpty());
    }

  
    void getNameWhenNameIsNullThenReturnNull() {
        Product product = new Product();
        product.setName(null);
        assertNull(product.getName());
    }

  
    void getNameAfterMultipleUpdatesThenReturnLastValue() {
        Product product = new Product();
        product.setName("Tablet");
        product.setName("Monitor");
        assertEquals("Monitor", product.getName());
    }

  
    void getNameWithSpecialCharactersThenReturnExactValue() {
        Product product = new Product();
        String specialName = "Mega® Pro_500!";
        product.setName(specialName);
        assertEquals(specialName, product.getName());
    }

  
    void getNameWhenOtherFieldsModifiedThenUnaffected() {
        Product product = new Product();
        product.setName("Chair");
        product.setPrice(199.99);
        product.setDescription("Ergonomic");
        assertEquals("Chair", product.getName());
    }

  
    void getNameWithMaxLengthStringThenReturnFullValue() {
        Product product = new Product();
        StringBuilder longName = new StringBuilder();
        for (int i = 0; i < 1000; i++) {
            longName.append("a");
        }
        product.setName(longName.toString());
        assertEquals(1000, product.getName().length());
    }

  public void testGetDescriptionWhenDescriptionIsSetReturnsCorrectValue() {
        Product product = new Product();
        product.setDescription("Sample product description");
        assertEquals("Sample product description", product.getDescription());
    }

  public void testGetDescriptionWhenDescriptionIsNullReturnsNull() {
        Product product = new Product();
        assertNull(product.getDescription());
    }

  public void testGetDescriptionAfterModificationReflectsUpdate() {
        Product product = new Product();
        product.setDescription("Initial description");
        product.setDescription("Revised description");
        assertEquals("Revised description", product.getDescription());
    }

  public void testGetDescriptionWithEmptyStringReturnsEmpty() {
        Product product = new Product();
        product.setDescription("");
        assertEquals("", product.getDescription());
    }

  public void testGetDescriptionPersistsAcrossInstances() {
        Product productA = new Product();
        productA.setDescription("First product");
        
        Product productB = new Product();
        productB.setDescription("Second product");
        
        assertEquals("First product", productA.getDescription());
        assertEquals("Second product", productB.getDescription());
    }

  public void testGetPriceWhenSetToPositiveValue() {
        Product product = new Product();
        product.setPrice(29.99);
        assertEquals(29.99, product.getPrice(), 0.001);
    }

  public void testGetPriceWithoutInitialization() {
        Product product = new Product();
        assertEquals(0.0, product.getPrice(), 0.0);
    }

  public void testGetPriceWithHighPrecisionValue() {
        Product product = new Product();
        product.setPrice(15.987654321);
        assertEquals(15.987654321, product.getPrice(), 0.000000001);
    }

  public void testGetPriceAfterMultipleUpdates() {
        Product product = new Product();
        product.setPrice(9.99);
        product.setPrice(14.99);
        assertEquals(14.99, product.getPrice(), 0.001);
    }

  public void testGetPriceWhenSetToNegativeValue() {
        Product product = new Product();
        product.setPrice(-5.75);
        assertEquals(-5.75, product.getPrice(), 0.001);
    }

  public void testGetPriceWhenSetToZero() {
        Product product = new Product();
        product.setPrice(0.0);
        assertEquals(0.0, product.getPrice(), 0.0);
    }

  public void testGetPriceWithExtremelyLargeValue() {
        Product product = new Product();
        product.setPrice(Double.MAX_VALUE);
        assertEquals(Double.MAX_VALUE, product.getPrice(), 0.0);
    }

