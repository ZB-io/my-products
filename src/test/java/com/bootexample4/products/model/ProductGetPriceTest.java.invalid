package com.bootexample4.products.model;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;

@SpringBootTest
public class ProductGetPriceTest {
    private Product product;
    @BeforeEach
    void setUp() {
        product = new Product();
    }
    @Test
    @Tag("valid")
    @DisplayName("Retrieve Price When Price Is Set To Positive Value")
    void getPriceReturnsPositiveValue() {
        // Arrange
        double expectedPrice = 99.99;
        product.setPrice(expectedPrice);
        // Act
        double actualPrice = product.getPrice();
        // Assert
        assertEquals(expectedPrice, actualPrice, "Price should be 99.99");
    }
    @Test
    @Tag("valid")
    @DisplayName("Retrieve Price When Price Is Set To Zero")
    void getPriceReturnsZeroWhenPriceIsZero() {
        // Arrange
        double expectedPrice = 0.0;
        product.setPrice(expectedPrice);
        // Act
        double actualPrice = product.getPrice();
        // Assert
        assertEquals(expectedPrice, actualPrice, "Price should be 0.0");
    }
    @Test
    @Tag("boundary")
    @DisplayName("Retrieve Price When Price Is Set To Negative Value")
    void getPriceReturnsNegativeValue() {
        // Arrange
        double expectedPrice = -10.50;
        product.setPrice(expectedPrice);
        // Act
        double actualPrice = product.getPrice();
        // Assert
        assertEquals(expectedPrice, actualPrice, "Price should be -10.50");
    }
    @Test
    @Tag("valid")
    @DisplayName("Retrieve Default Price When Price Is Not Explicitly Set")
    void getPriceReturnsDefaultValueWhenNotSet() {
        // Arrange
        // No price set - using default value
        // Act
        double actualPrice = product.getPrice();
        // Assert
        assertEquals(0.0, actualPrice, "Default price should be 0.0");
    }
    @Test
    @Tag("boundary")
    @DisplayName("Retrieve Price With Large Decimal Value")
    void getPriceReturnsLargeDecimalValue() {
        // Arrange
        double expectedPrice = 999999.99;
        product.setPrice(expectedPrice);
        // Act
        double actualPrice = product.getPrice();
        // Assert
        assertEquals(expectedPrice, actualPrice, "Price should be 999999.99");
    }
    @Test
    @Tag("boundary")
    @DisplayName("Retrieve Price With Very Small Decimal Value")
    void getPriceReturnsVerySmallDecimalValue() {
        // Arrange
        double expectedPrice = 0.01;
        product.setPrice(expectedPrice);
        // Act
        double actualPrice = product.getPrice();
        // Assert
        assertEquals(expectedPrice, actualPrice, "Price should be 0.01");
    }
    @Test
    @Tag("valid")
    @DisplayName("Retrieve Price After Multiple Price Updates")
    void getPriceReturnsLatestValueAfterMultipleUpdates() {
        // Arrange
        product.setPrice(10.00);
        product.setPrice(20.00);
        product.setPrice(30.00);
        double expectedPrice = 30.00;
        // Act
        double actualPrice = product.getPrice();
        // Assert
        assertEquals(expectedPrice, actualPrice, "Price should be 30.00 after multiple updates");
    }
    @Test
    @Tag("boundary")
    @DisplayName("Retrieve Price With Maximum Double Value")
    void getPriceReturnsMaxDoubleValue() {
        // Arrange
        double expectedPrice = Double.MAX_VALUE;
        product.setPrice(expectedPrice);
        // Act
        double actualPrice = product.getPrice();
        // Assert
        assertEquals(expectedPrice, actualPrice, "Price should be Double.MAX_VALUE");
    }
}