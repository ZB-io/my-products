package com.bootexample4.products.model;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import org.junit.jupiter.api.*;

@SpringBootTest
public class ProductGetNameTest {
    private Product product;
    @BeforeEach
    void setUp() {
        product = new Product();
    }
    @Test
    @Tag("valid")
    void getNameReturnsValidStringWhenNameIsSet() {
        // Arrange
        String expectedName = "Test Product";
        product.setName(expectedName);
        // Act
        String actualName = product.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
    @Test
    @Tag("valid")
    void getNameReturnsNullWhenNameIsNull() {
        // Arrange
        product.setName(null);
        // Act
        String actualName = product.getName();
        // Assert
        assertNull(actualName);
    }
    @Test
    @Tag("boundary")
    void getNameReturnsNullWhenNameIsNeverSet() {
        // Arrange
        // Product instance created in setUp() without setting any values
        // Act
        String actualName = product.getName();
        // Assert
        assertNull(actualName);
    }
    @Test
    @Tag("boundary")
    void getNameReturnsEmptyStringWhenNameIsEmpty() {
        // Arrange
        String expectedName = "";
        product.setName(expectedName);
        // Act
        String actualName = product.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
    @Test
    @Tag("valid")
    void getNameReturnsStringWithSpecialCharacters() {
        // Arrange
        String expectedName = "Product@#$%^&*()!";
        product.setName(expectedName);
        // Act
        String actualName = product.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
    @Test
    @Tag("boundary")
    void getNameReturnsWhitespaceStringWhenNameIsWhitespace() {
        // Arrange
        String expectedName = "   ";
        product.setName(expectedName);
        // Act
        String actualName = product.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
    @Test
    @Tag("valid")
    void getNameReturnsLatestValueAfterMultipleUpdates() {
        // Arrange
        product.setName("First Name");
        product.setName("Second Name");
        String expectedName = "Final Name";
        product.setName(expectedName);
        // Act
        String actualName = product.getName();
        // Assert
        assertEquals(expectedName, actualName);
    }
}