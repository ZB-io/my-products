package com.bootexample4.products.model;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

@SpringBootTest
class ProductGetDescriptionTest {
    private Product product;
    @BeforeEach
    void setUp() {
        product = new Product();
    }
    @Test
    @Tag("valid")
    @DisplayName("getDescriptionReturnsValidStringWhenSet")
    void getDescriptionReturnsValidStringWhenSet() {
        // Arrange
        String expectedDescription = "This is a valid product description";
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
    }
    @Test
    @Tag("valid")
    @DisplayName("getDescriptionReturnsNullWhenNotSet")
    void getDescriptionReturnsNullWhenNotSet() {
        // Arrange - Product instance created in setUp without setting description
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertNull(actualDescription);
    }
    @Test
    @Tag("boundary")
    @DisplayName("getDescriptionReturnsEmptyStringWhenSetToEmpty")
    void getDescriptionReturnsEmptyStringWhenSetToEmpty() {
        // Arrange
        String expectedDescription = "";
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
        assertTrue(actualDescription.isEmpty());
    }
    @Test
    @Tag("valid")
    @DisplayName("getDescriptionReturnsStringWithSpecialCharacters")
    void getDescriptionReturnsStringWithSpecialCharacters() {
        // Arrange
        String expectedDescription = "Product with special chars: @#$%^&*()!<>?/\\";
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
    }
    @Test
    @Tag("valid")
    @DisplayName("getDescriptionReturnsStringWithUnicodeCharacters")
    void getDescriptionReturnsStringWithUnicodeCharacters() {
        // Arrange
        String expectedDescription = "产品描述 - Descripción del producto - תיאור המוצר";
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
    }
    @Test
    @Tag("boundary")
    @DisplayName("getDescriptionReturnsVeryLongString")
    void getDescriptionReturnsVeryLongString() {
        // Arrange
        StringBuilder longDescriptionBuilder = new StringBuilder();
        for (int i = 0; i < 10000; i++) {
            longDescriptionBuilder.append("a");
        }
        String expectedDescription = longDescriptionBuilder.toString();
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
        assertEquals(10000, actualDescription.length());
    }
    @Test
    @Tag("boundary")
    @DisplayName("getDescriptionReturnsWhitespaceOnlyString")
    void getDescriptionReturnsWhitespaceOnlyString() {
        // Arrange
        String expectedDescription = "   \t  ";
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
    }
    @Test
    @Tag("valid")
    @DisplayName("getDescriptionReturnsLatestValueAfterMultipleUpdates")
    void getDescriptionReturnsLatestValueAfterMultipleUpdates() {
        // Arrange
        product.setDescription("First description");
        product.setDescription("Second description");
        String expectedDescription = "Final description";
        product.setDescription(expectedDescription);
        // Act
        String actualDescription = product.getDescription();
        // Assert
        assertEquals(expectedDescription, actualDescription);
    }
}