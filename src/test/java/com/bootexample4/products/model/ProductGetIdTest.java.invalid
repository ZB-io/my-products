package com.bootexample4.products.model;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.Arguments;
import org.junit.jupiter.params.provider.MethodSource;
import org.springframework.boot.test.context.SpringBootTest;
import java.util.stream.Stream;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

class ProductGetIdTest {
    private Product product;
    @BeforeEach
    void setUp() {
        product = new Product();
    }
    @Test
    @Tag("valid")
    @DisplayName("Retrieve ID When ID Is Set To A Positive Value")
    void getIdReturnsPositiveValueWhenSet() {
        // Arrange
        Long expectedId = 1L;
        product.setId(expectedId);
        // Act
        Long actualId = product.getId();
        // Assert
        assertNotNull(actualId);
        assertEquals(expectedId, actualId);
    }
    @Test
    @Tag("valid")
    @DisplayName("Retrieve ID When ID Is Null (Default State)")
    void getIdReturnsNullWhenNotSet() {
        // Arrange
        // Product instance created in setUp() without setting id
        // Act
        Long actualId = product.getId();
        // Assert
        assertNull(actualId);
    }
    @Test
    @Tag("boundary")
    @DisplayName("Retrieve ID When ID Is Set To Zero")
    void getIdReturnsZeroWhenSetToZero() {
        // Arrange
        Long expectedId = 0L;
        product.setId(expectedId);
        // Act
        Long actualId = product.getId();
        // Assert
        assertNotNull(actualId);
        assertEquals(expectedId, actualId);
    }
    @Test
    @Tag("boundary")
    @DisplayName("Retrieve ID When ID Is Set To Maximum Long Value")
    void getIdReturnsMaxLongValueWhenSet() {
        // Arrange
        Long expectedId = Long.MAX_VALUE;
        product.setId(expectedId);
        // Act
        Long actualId = product.getId();
        // Assert
        assertNotNull(actualId);
        assertEquals(expectedId, actualId);
    }
    @Test
    @Tag("boundary")
    @DisplayName("Retrieve ID When ID Is Set To Negative Value")
    void getIdReturnsNegativeValueWhenSet() {
        // Arrange
        Long expectedId = -1L;
        product.setId(expectedId);
        // Act
        Long actualId = product.getId();
        // Assert
        assertNotNull(actualId);
        assertEquals(expectedId, actualId);
    }
    @Test
    @Tag("valid")
    @DisplayName("Retrieve ID After Multiple Set Operations")
    void getIdReturnsLastSetValue() {
        // Arrange
        Long initialId = 1L;
        Long finalId = 100L;
        product.setId(initialId);
        product.setId(finalId);
        // Act
        Long actualId = product.getId();
        // Assert
        assertNotNull(actualId);
        assertEquals(finalId, actualId);
        assertNotEquals(initialId, actualId);
    }
    @Test
    @Tag("valid")
    @DisplayName("Retrieve ID When Other Fields Are Populated")
    void getIdReturnsCorrectValueWithOtherFieldsSet() {
        // Arrange
        Long expectedId = 5L;
        product.setId(expectedId);
        product.setName("Test Product");
        product.setDescription("Test Description");
        product.setPrice(99.99);
        // Act
        Long actualId = product.getId();
        // Assert
        assertNotNull(actualId);
        assertEquals(expectedId, actualId);
    }
    @ParameterizedTest
    @MethodSource("provideIdValues")
    @Tag("valid")
    @DisplayName("Retrieve ID With Various Valid Values")
    void getIdReturnsCorrectValueForVariousInputs(Long inputId, Long expectedId) {
        // Arrange
        product.setId(inputId);
        // Act
        Long actualId = product.getId();
        // Assert
        assertEquals(expectedId, actualId);
    }
    private static Stream<Arguments> provideIdValues() {
        return Stream.of(
            Arguments.of(1L, 1L),
            Arguments.of(0L, 0L),
            Arguments.of(-1L, -1L),
            Arguments.of(Long.MAX_VALUE, Long.MAX_VALUE),
            Arguments.of(Long.MIN_VALUE, Long.MIN_VALUE),
            Arguments.of(null, null),
            Arguments.of(999999999L, 999999999L)
        );
    }
    @Test
    @Tag("boundary")
    @DisplayName("Retrieve ID When ID Is Set To Minimum Long Value")
    void getIdReturnsMinLongValueWhenSet() {
        // Arrange
        Long expectedId = Long.MIN_VALUE;
        product.setId(expectedId);
        // Act
        Long actualId = product.getId();
        // Assert
        assertNotNull(actualId);
        assertEquals(expectedId, actualId);
    }
    @Test
    @Tag("valid")
    @DisplayName("Retrieve ID After Setting To Null")
    void getIdReturnsNullAfterSettingToNull() {
        // Arrange
        product.setId(10L);
        product.setId(null);
        // Act
        Long actualId = product.getId();
        // Assert
        assertNull(actualId);
    }
}