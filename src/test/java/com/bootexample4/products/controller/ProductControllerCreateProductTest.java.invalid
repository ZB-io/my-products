```javapackage com.bootexample4.products.controller;
import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.http.ResponseEntity;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

class ProductControllerCreateProductTest {
    @Mock
    private ProductRepository productRepository;
    @InjectMocks
    private ProductController productController;
    @BeforeEach
    void setup() {
        MockitoAnnotations.openMocks(this);
    }
    @Test
    @Tag("valid")
    public void createValidProductSuccessfully() {
        // Arrange
        Product validProduct = new Product();
        validProduct.setId(1L);
        validProduct.setName("Sample Product");
        validProduct.setDescription("Sample Description");
        validProduct.setPrice(99.99);
        
        when(productRepository.save(validProduct)).thenReturn(validProduct);
        // Act
        Product createdProduct = productController.createProduct(validProduct);
        // Assert
        assertNotNull(createdProduct);
        assertEquals(validProduct.getId(), createdProduct.getId());
        assertEquals(validProduct.getName(), createdProduct.getName());
        assertEquals(validProduct.getDescription(), createdProduct.getDescription());
        assertEquals(validProduct.getPrice(), createdProduct.getPrice());
        verify(productRepository, times(1)).save(validProduct);
    }
    @Test
    @Tag("invalid")
    public void createProductWithNullInput() {
        // Arrange
        Product nullProduct = null;
        // Act & Assert
        assertThrows(IllegalArgumentException.class, () -> {
            productController.createProduct(nullProduct);
        });
        verify(productRepository, never()).save(any());
    }
    @Test
    @Tag("invalid")
    public void createProductWithInvalidFields() {
        // Arrange
        Product invalidProduct = new Product();
        invalidProduct.setId(1L);
        // Missing essential fields: name, description, price
        when(productRepository.save(invalidProduct)).thenThrow(new IllegalArgumentException("Invalid product fields"));
        // Act & Assert
        assertThrows(IllegalArgumentException.class, () -> {
            productController.createProduct(invalidProduct);
        });
        verify(productRepository, never()).save(any());
    }
    @Test
    @Tag("integration")
    public void verifyRepositorySaveIsCalled() {
        // Arrange
        Product validProduct = new Product();
        validProduct.setId(1L);
        validProduct.setName("Product Name");
        validProduct.setDescription("Product Description");
        validProduct.setPrice(49.99);
        when(productRepository.save(validProduct)).thenReturn(validProduct);
        // Act
        productController.createProduct(validProduct);
        // Assert
        verify(productRepository, times(1)).save(validProduct);
    }
    @Test
    @Tag("boundary")
    public void saveReturnsDifferentProduct() {
        // Arrange
        Product inputProduct = new Product();
        inputProduct.setId(1L);
        inputProduct.setName("Input Name");
        inputProduct.setDescription("Input Description");
        inputProduct.setPrice(19.99);
        Product repositoryReturnedProduct = new Product();
        repositoryReturnedProduct.setId(2L);
        repositoryReturnedProduct.setName("Modified Name");
        repositoryReturnedProduct.setDescription("Modified Description");
        repositoryReturnedProduct.setPrice(39.99);
        when(productRepository.save(inputProduct)).thenReturn(repositoryReturnedProduct);
        // Act
        Product createdProduct = productController.createProduct(inputProduct);
        // Assert
        assertNotNull(createdProduct);
        assertEquals(repositoryReturnedProduct.getId(), createdProduct.getId());
        assertEquals(repositoryReturnedProduct.getName(), createdProduct.getName());
        assertEquals(repositoryReturnedProduct.getDescription(), createdProduct.getDescription());
        assertEquals(repositoryReturnedProduct.getPrice(), createdProduct.getPrice());
        verify(productRepository, times(1)).save(inputProduct);
    }
    @Test
    @Tag("invalid")
    public void createProductWithDuplicateData() {
        // NOTE: Modify duplicate checking as per business rules
        // Arrange
        Product duplicateProduct = new Product();
        duplicateProduct.setId(1L);
        duplicateProduct.setName("Existing Name");
        duplicateProduct.setDescription("Existing Description");
        duplicateProduct.setPrice(19.99);
        when(productRepository.save(duplicateProduct)).thenThrow(new IllegalArgumentException("Duplicate product data"));
        // Act & Assert
        assertThrows(IllegalArgumentException.class, () -> {
            productController.createProduct(duplicateProduct);
        });
        verify(productRepository, never()).save(any());
    }
    @Test
    @Tag("boundary")
    public void createProductWithExcessiveData() {
        // Arrange
        Product largeDataProduct = new Product();
        largeDataProduct.setId(1L);
        largeDataProduct.setName("Large".repeat(1000));
        largeDataProduct.setDescription("Description".repeat(1000));
        largeDataProduct.setPrice(19.99);
        when(productRepository.save(largeDataProduct)).thenReturn(largeDataProduct);
        // Act
        Product createdProduct = productController.createProduct(largeDataProduct);
        // Assert
        assertNotNull(createdProduct);
        assertEquals(largeDataProduct.getId(), createdProduct.getId());
        assertEquals(largeDataProduct.getName(), createdProduct.getName());
        assertEquals(largeDataProduct.getDescription(), createdProduct.getDescription());
        assertEquals(largeDataProduct.getPrice(), createdProduct.getPrice());
        verify(productRepository, times(1)).save(largeDataProduct);
    }
    @Test
    @Tag("integration")
    public void repositorySaveFailureScenario() {
        // Arrange
        Product validProduct = new Product();
        validProduct.setId(1L);
        validProduct.setName("Valid Name");
        validProduct.setDescription("Valid Description");
        validProduct.setPrice(19.99);
        when(productRepository.save(validProduct)).thenThrow(new RuntimeException("Database failure"));
        // Act & Assert
        assertThrows(RuntimeException.class, () -> {
            productController.createProduct(validProduct);
        });
        verify(productRepository, times(1)).save(validProduct);
    }
    @Test
    @Tag("boundary")
    public void createProductWithHighPrecisionPrice() {
        // Arrange
        Product highPrecisionPriceProduct = new Product();
        highPrecisionPriceProduct.setId(1L);
        highPrecisionPriceProduct.setName("Precise Name");
        highPrecisionPriceProduct.setDescription("Precise Description");
        highPrecisionPriceProduct.setPrice(19.999999999);
        when(productRepository.save(highPrecisionPriceProduct)).thenReturn(highPrecisionPriceProduct);
        // Act
        Product createdProduct = productController.createProduct(highPrecisionPriceProduct);
        // Assert
        assertNotNull(createdProduct);
        assertEquals(highPrecisionPriceProduct.getId(), createdProduct.getId());
        assertEquals(highPrecisionPriceProduct.getName(), createdProduct.getName());
        assertEquals(highPrecisionPriceProduct.getDescription(), createdProduct.getDescription());
        assertEquals(highPrecisionPriceProduct.getPrice(), createdProduct.getPrice());
        verify(productRepository, times(1)).save(highPrecisionPriceProduct);
    }
    @Test
    @Tag("boundary")
    public void createProductWithSpecialCharacters() {
        // Arrange
        Product specialCharactersProduct = new Product();
        specialCharactersProduct.setId(1L);
        specialCharactersProduct.setName("Name @#$%");
        specialCharactersProduct.setDescription("Description !@#$%");
        specialCharactersProduct.setPrice(19.99);
        when(productRepository.save(specialCharactersProduct)).thenReturn(specialCharactersProduct);
        // Act
        Product createdProduct = productController.createProduct(specialCharactersProduct);
        // Assert
        assertNotNull(createdProduct);
        assertEquals(specialCharactersProduct.getId(), createdProduct.getId());
        assertEquals(specialCharactersProduct.getName(), createdProduct.getName());
        assertEquals(specialCharactersProduct.getDescription(), createdProduct.getDescription());
        assertEquals(specialCharactersProduct.getPrice(), createdProduct.getPrice());
        verify(productRepository, times(1)).save(specialCharactersProduct);
    }
