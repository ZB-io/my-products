import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@ExtendWith(MockitoExtension.class)
public class ProductControllerCreateProductTest {
    @Mock
    private ProductRepository productRepository;
    @InjectMocks
    private ProductController productController;
    private Product validProduct;
    @BeforeEach
    void setup() {
        validProduct = new Product();
        validProduct.setName("Test Product");
        validProduct.setDescription("Test Description");
        validProduct.setPrice(100.0); // Valid price setup
    }
    @Test
    @Tag("valid")
    public void createProductWithValidData() {
        when(productRepository.save(validProduct)).thenReturn(validProduct);
        Product result = productController.createProduct(validProduct);
        assertEquals(validProduct, result, "The returned product should match the valid input.");
        verify(productRepository, times(1)).save(validProduct);
    }
    @Test
    @Tag("invalid")
    public void createProductWithNullProduct() {
        assertThrows(NullPointerException.class, () -> productController.createProduct(null), "Null product should throw NullPointerException.");
        verify(productRepository, never()).save(any(Product.class));
    }
    @Test
    @Tag("invalid")
    public void createProductWithIncompleteProductData() {
        Product incompleteProduct = new Product();
        incompleteProduct.setName(null); // Mandatory field setup as null
        incompleteProduct.setDescription("Incomplete Product");
        incompleteProduct.setPrice(50.0); // Setting valid price to prevent type issues
        // Comment: If validation for mandatory fields is required, the business logic should enforce constraints.
        
        when(productRepository.save(incompleteProduct)).thenReturn(incompleteProduct);
        Product result = productController.createProduct(incompleteProduct);
        assertEquals(incompleteProduct, result, "Incomplete product data should still be saved as-is if validation is not enforced.");
    }
    @Test
    @Tag("invalid")
    public void createProductWithRepositoryFailure() {
        when(productRepository.save(validProduct)).thenThrow(new RuntimeException("Database issue"));
        assertThrows(RuntimeException.class, () -> productController.createProduct(validProduct), "Repository save failure should propagate RuntimeException.");
        verify(productRepository, times(1)).save(validProduct);
    }
    @Test
    @Tag("integration")
    public void createProductRepositorySaveIsCalledOnce() {
        when(productRepository.save(validProduct)).thenReturn(validProduct);
        productController.createProduct(validProduct);
        verify(productRepository, times(1)).save(validProduct);
    }
    @Test
    @Tag("boundary")
    public void createProductWithLongTextFields() {
        String longName = "L".repeat(500);
        String longDescription = "D".repeat(1000);
        Product largeTextProduct = new Product();
        largeTextProduct.setName(longName);
        largeTextProduct.setDescription(longDescription);
        largeTextProduct.setPrice(150.0); // Valid price setup
        when(productRepository.save(largeTextProduct)).thenReturn(largeTextProduct);
        Product result = productController.createProduct(largeTextProduct);
        assertEquals(longName, result.getName(), "The name field should not be truncated or modified.");
        assertEquals(longDescription, result.getDescription(), "The description field should not be truncated or modified.");
    }
    @Test
    @Tag("invalid")
    public void createProductWithNegativePrice() {
        Product negativePriceProduct = new Product();
        negativePriceProduct.setName("Negative Price Product");
        negativePriceProduct.setDescription("Negative Price Description");
        negativePriceProduct.setPrice(-100.0); // Valid negative price setup
        when(productRepository.save(negativePriceProduct)).thenReturn(negativePriceProduct);
        Product result = productController.createProduct(negativePriceProduct);
        assertEquals(-100.0, result.getPrice(), "Products with negative price should still reflect the provided value.");
    }
    @Test
    @Tag("valid")
    public void createProductWithZeroPrice() {
        Product zeroPriceProduct = new Product();
        zeroPriceProduct.setName("Zero Price Product");
        zeroPriceProduct.setDescription("Zero Price Description");
        zeroPriceProduct.setPrice(0.0); // Zero price setup
        when(productRepository.save(zeroPriceProduct)).thenReturn(zeroPriceProduct);
        Product result = productController.createProduct(zeroPriceProduct);
        assertEquals(0.0, result.getPrice(), "Product price of zero should be reflected correctly.");
    }
    @Test
    @Tag("valid")
    public void createProductReturnsSavedProduct() {
        when(productRepository.save(validProduct)).thenReturn(validProduct);
        Product result = productController.createProduct(validProduct);
        assertSame(validProduct, result, "Returned product should be identical to the saved product.");
    }
    @Test
    @Tag("boundary")
    public void createProductWithEdgeCasePriceValues() {
        Product maxValueProduct = new Product();
        maxValueProduct.setName("Max Value Price");
        maxValueProduct.setDescription("Max Value Description");
        maxValueProduct.setPrice(Double.MAX_VALUE); // Valid maximum price setup
        Product minValueProduct = new Product();
        minValueProduct.setName("Min Value Price");
        minValueProduct.setDescription("Min Value Description");
        minValueProduct.setPrice(0.0); // Changing from Double.MIN_VALUE to valid minimal price (non-zero)
        when(productRepository.save(maxValueProduct)).thenReturn(maxValueProduct);
        when(productRepository.save(minValueProduct)).thenReturn(minValueProduct);
        Product maxValueResult = productController.createProduct(maxValueProduct);
        Product minValueResult = productController.createProduct(minValueProduct);
        assertEquals(Double.MAX_VALUE, maxValueResult.getPrice(), "Price value should handle Double.MAX_VALUE correctly.");
        assertEquals(0.0, minValueResult.getPrice(), "Price value should handle minimal valid price correctly."); // Adjusted as MIN_VALUE isn't relevant here
        verify(productRepository, times(1)).save(maxValueProduct);
        verify(productRepository, times(1)).save(minValueProduct);
