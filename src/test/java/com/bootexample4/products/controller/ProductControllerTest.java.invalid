@Test
@Tag("valid")
public void updateProductWithSameDataReturnsOriginal() {
    Product existingProduct = new Product();
    existingProduct.setId(1L);
    existingProduct.setName("Same");
    existingProduct.setDescription("Same Desc");
    existingProduct.setPrice(30.0);
    Product sameData = new Product();
    sameData.setName("Same");
    sameData.setDescription("Same Desc");
    sameData.setPrice(30.0);
    when(productRepository.findById(1L)).thenReturn(Optional.of(existingProduct));
    when(productRepository.save(existingProduct)).thenReturn(existingProduct);
    ResponseEntity<Product> response = controller.updateProduct(1L, sameData);
    assertEquals(HttpStatus.OK, response.getStatusCode());
    Product updated = response.getBody();
    assertEquals("Same", updated.getName());
    assertEquals("Same Desc", updated.getDescription());
    assertEquals(30.0, updated.getPrice());
    verify(productRepository, times(1)).save(existingProduct);
}

