@Test
@Tag("boundary")
public void updateProductWithBoundaryValuesSucceeds() {
    String maxName = new String(new char[255]).replace('\0', 'a');
    Product existingProduct = new Product();
    existingProduct.setId(1L);
    existingProduct.setName("Old");
    existingProduct.setDescription("Old Desc");
    existingProduct.setPrice(0.0);
    Product boundaryData = new Product();
    boundaryData.setName(maxName);
    boundaryData.setDescription("Max Desc");
    boundaryData.setPrice(Double.MAX_VALUE);
    when(productRepository.findById(1L)).thenReturn(Optional.of(existingProduct));
    when(productRepository.save(existingProduct)).thenReturn(existingProduct);
    ResponseEntity<Product> response = controller.updateProduct(1L, boundaryData);
    assertEquals(HttpStatus.OK, response.getStatusCode());
    Product updated = response.getBody();
    assertEquals(maxName, updated.getName());
    assertEquals("Max Desc", updated.getDescription());
    assertEquals(Double.MAX_VALUE, updated.getPrice());
}

