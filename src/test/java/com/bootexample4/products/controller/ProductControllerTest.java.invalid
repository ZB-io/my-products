    void setUp() {
        product1 = new Product();
        product1.setName("Product 1");
        product1.setDescription("Description 1");
        product1.setPrice(10.99);
        product2 = new Product();
        product2.setName("Product 2");
        product2.setDescription("Description 2");
        product2.setPrice(20.99);
        product3 = new Product();
        product3.setName("Product 3");
        product3.setDescription("Description 3");
        product3.setPrice(30.99);
    }

  
    void getAllProductsReturnsListWhenProductsExist() {
        // Arrange
        List<Product> expectedProducts = Arrays.asList(product1, product2, product3);
        when(productRepository.findAll()).thenReturn(expectedProducts);
        // Act
        List<Product> actualProducts = productController.getAllProducts();
        // Assert
        assertNotNull(actualProducts);
        assertEquals(3, actualProducts.size());
        assertEquals(expectedProducts, actualProducts);
    }

  
    void getAllProductsReturnsEmptyListWhenNoProductsExist() {
        // Arrange
        List<Product> emptyList = Collections.emptyList();
        when(productRepository.findAll()).thenReturn(emptyList);
        // Act
        List<Product> actualProducts = productController.getAllProducts();
        // Assert
        assertNotNull(actualProducts);
        assertTrue(actualProducts.isEmpty());
        assertEquals(0, actualProducts.size());
    }

  
    void getAllProductsReturnsCorrectProductData() {
        // Arrange
        Product expectedProduct = new Product();
        expectedProduct.setName("Test Product");
        expectedProduct.setDescription("Test Description");
        expectedProduct.setPrice(99.99);
        
        List<Product> expectedProducts = Collections.singletonList(expectedProduct);
        when(productRepository.findAll()).thenReturn(expectedProducts);
        // Act
        List<Product> actualProducts = productController.getAllProducts();
        // Assert
        assertNotNull(actualProducts);
        assertEquals(1, actualProducts.size());
        
        Product actualProduct = actualProducts.get(0);
        assertEquals(expectedProduct.getName(), actualProduct.getName());
        assertEquals(expectedProduct.getDescription(), actualProduct.getDescription());
        assertEquals(expectedProduct.getPrice(), actualProduct.getPrice());
    }

  
    void getAllProductsCallsRepositoryFindAllOnce() {
        // Arrange
        when(productRepository.findAll()).thenReturn(new ArrayList<>());
        // Act
        productController.getAllProducts();
        // Assert
        verify(productRepository, times(1)).findAll();
    }

  
    void getAllProductsReturnsSingleProductList() {
        // Arrange
        List<Product> singleProductList = Collections.singletonList(product1);
        when(productRepository.findAll()).thenReturn(singleProductList);
        // Act
        List<Product> actualProducts = productController.getAllProducts();
        // Assert
        assertNotNull(actualProducts);
        assertEquals(1, actualProducts.size());
        assertEquals(product1, actualProducts.get(0));
    }

  
    void getAllProductsThrowsExceptionWhenRepositoryFails() {
        // Arrange
        RuntimeException expectedException = new RuntimeException("Database connection failed");
        when(productRepository.findAll()).thenThrow(expectedException);
        // Act & Assert
        RuntimeException thrownException = assertThrows(RuntimeException.class, () -> {
            productController.getAllProducts();
        });
        assertEquals("Database connection failed", thrownException.getMessage());
    }

  
    void setUp_2() {
        validProduct = new Product();
        validProduct.setName("Test Product");
        validProduct.setDescription("Test Description");
        validProduct.setPrice(99.99);
    }

  
    void createProductWithValidData() {
        // Arrange
        when(productRepository.save(any(Product.class))).thenReturn(validProduct);
        // Act
        Product result = productController.createProduct(validProduct);
        // Assert
        assertNotNull(result);
        assertEquals(validProduct.getName(), result.getName());
        assertEquals(validProduct.getDescription(), result.getDescription());
        assertEquals(validProduct.getPrice(), result.getPrice());
        verify(productRepository, times(1)).save(validProduct);
    }

  
    void createProductWithNullObject() {
        // Arrange
        when(productRepository.save(null)).thenReturn(null);
        // Act
        Product result = productController.createProduct(null);
        // Assert
        assertNull(result);
        verify(productRepository, times(1)).save(null);
    }

  
    void createProductVerifiesRepositorySaveCall() {
        // Arrange
        ArgumentCaptor<Product> productCaptor = ArgumentCaptor.forClass(Product.class);
        when(productRepository.save(any(Product.class))).thenReturn(validProduct);
        // Act
        productController.createProduct(validProduct);
        // Assert
        verify(productRepository, times(1)).save(productCaptor.capture());
        Product capturedProduct = productCaptor.getValue();
        assertEquals(validProduct.getName(), capturedProduct.getName());
        assertEquals(validProduct.getDescription(), capturedProduct.getDescription());
        assertEquals(validProduct.getPrice(), capturedProduct.getPrice());
    }

  
    void createProductReturnsSavedProductFromRepository() {
        // Arrange
        Product inputProduct = new Product();
        inputProduct.setName("Input Product");
        inputProduct.setDescription("Input Description");
        inputProduct.setPrice(50.00);
        Product savedProduct = new Product();
        savedProduct.setName("Input Product");
        savedProduct.setDescription("Input Description");
        savedProduct.setPrice(50.00);
        when(productRepository.save(inputProduct)).thenReturn(savedProduct);
        // Act
        Product result = productController.createProduct(inputProduct);
        // Assert
        assertSame(savedProduct, result);
    }

  
    void createProductWhenRepositoryThrowsException() {
        // Arrange
        when(productRepository.save(any(Product.class))).thenThrow(new RuntimeException("Database error"));
        // Act & Assert
        assertThrows(RuntimeException.class, () -> {
            productController.createProduct(validProduct);
        });
        verify(productRepository, times(1)).save(validProduct);
    }

  
