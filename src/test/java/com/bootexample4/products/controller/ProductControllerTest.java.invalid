@Test
@Tag("valid")
public void updateProductWithPartialDataOverwritesFields() {
    Product existingProduct = new Product();
    existingProduct.setId(1L);
    existingProduct.setName("Old");
    existingProduct.setDescription("Old Desc");
    existingProduct.setPrice(100.0);
    Product partialUpdate = new Product();
    partialUpdate.setName(null);
    partialUpdate.setDescription("New Desc");
    partialUpdate.setPrice(50.0);
    when(productRepository.findById(1L)).thenReturn(Optional.of(existingProduct));
    when(productRepository.save(existingProduct)).thenReturn(existingProduct);
    ResponseEntity<Product> response = controller.updateProduct(1L, partialUpdate);
    assertEquals(HttpStatus.OK, response.getStatusCode());
    Product updated = response.getBody();
    assertNull(updated.getName());
    assertEquals("New Desc", updated.getDescription());
    assertEquals(50.0, updated.getPrice());
}

