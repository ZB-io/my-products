    void deleteProductCallsRepositoryDeleteWithCorrectProduct() {
        // Arrange
        Long productId = 1L;
        Product specificProduct = new Product();
        specificProduct.setName("Specific Product");
        specificProduct.setDescription("Specific Description");
        specificProduct.setPrice(150.00);
        when(productRepository.findById(productId)).thenReturn(Optional.of(specificProduct));
        doNothing().when(productRepository).delete(any(Product.class));
        // Act
        ResponseEntity<Object> response = productController.deleteProduct(productId);
        // Assert
        assertEquals(HttpStatus.OK, response.getStatusCode());
        
        ArgumentCaptor<Product> productCaptor = ArgumentCaptor.forClass(Product.class);
        verify(productRepository, times(1)).delete(productCaptor.capture());
        
        Product capturedProduct = productCaptor.getValue();
        assertSame(specificProduct, capturedProduct);
        assertEquals("Specific Product", capturedProduct.getName());
        assertEquals("Specific Description", capturedProduct.getDescription());
        assertEquals(150.00, capturedProduct.getPrice());
    }
