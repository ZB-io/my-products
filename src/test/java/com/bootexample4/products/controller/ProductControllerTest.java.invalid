@Tag("integration")
@Test
public void deleteProductAfterConcurrentModification() {
    Product mockProduct = new Product();
    when(productRepository.findById(777L)).thenReturn(Optional.of(mockProduct));
    doThrow(new EmptyResultDataAccessException(1)).when(productRepository).delete(mockProduct);
    ResponseEntity<Object> response = productController.deleteProduct(777L);
    assertEquals(HttpStatus.NOT_FOUND, response.getStatusCode());
}
