        when(updatedProduct.getName()).thenReturn("New Name");
        when(updatedProduct.getDescription()).thenReturn("New Description");
        when(updatedProduct.getPrice()).thenReturn(150.0);
        ResponseEntity<Product> response = productController.updateProduct(id, updatedProduct);
        assertEquals(ResponseEntity.ok(updatedProduct).getStatusCode(), response.getStatusCode());
        verify(productRepository).findById(id);
        verify(productRepository).save(existingProduct);
    }
