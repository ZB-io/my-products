```javapackage com.bootexample4.products.controller;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.Mockito.*;
import java.util.Optional;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.parallel.Execution;
import org.junit.jupiter.api.parallel.ExecutionMode;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import java.util.List;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

@Execution(ExecutionMode.CONCURRENT)
class ProductControllerUpdateProductTest {
    @InjectMocks
    private ProductController productController;
    @Mock
    private ProductRepository productRepository;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
    }
    @Test
    @Tag("valid")
    public void updateProductSuccessfully() {
        Long id = 1L;
        Product existingProduct = new Product(); // Existing product
        existingProduct.setName("Old Name");
        existingProduct.setDescription("Old Description");
        existingProduct.setPrice(100.00);
        Product updatedProduct = new Product(); // Update data
        updatedProduct.setName("New Name");
        updatedProduct.setDescription("New Description");
        updatedProduct.setPrice(150.00);
        // Mocking repository behavior
        when(productRepository.findById(id)).thenReturn(Optional.of(existingProduct));
        when(productRepository.save(any(Product.class))).thenReturn(updatedProduct);
        // Executing the updateProduct method in the controller
        ResponseEntity<Product> responseEntity = productController.updateProduct(id, updatedProduct);
        // Verifying the response details
        assertEquals(HttpStatus.OK, responseEntity.getStatusCode());
        assertEquals("New Name", responseEntity.getBody().getName());
        assertEquals("New Description", responseEntity.getBody().getDescription());
        assertEquals(150.00, responseEntity.getBody().getPrice(), 0.01); // for double comparison
        // Verifying interactions with the mock repository
        verify(productRepository, times(1)).findById(id);
        verify(productRepository, times(1)).save(any(Product.class));
    }
    @Test
    @Tag("invalid")
    public void updateProductWithNonExistentId() {
        Long id = 2L; // Non-existent product ID
        Product updatedProduct = new Product();
        updatedProduct.setName("New Name");
        updatedProduct.setDescription("New Description");
        updatedProduct.setPrice(150.00);
        // Mocking repository behavior for non-existent product
        when(productRepository.findById(id)).thenReturn(Optional.empty());
        // Executing the updateProduct method in the controller
        ResponseEntity<Product> responseEntity = productController.updateProduct(id, updatedProduct);
        // Verifying the response details
        assertEquals(HttpStatus.NOT_FOUND, responseEntity.getStatusCode());
        assertNull(responseEntity.getBody());
        // Verifying interactions with the mock repository
        verify(productRepository, times(1)).findById(id);
        verify(productRepository, never()).save(any(Product.class));
    }
}
